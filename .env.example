# ---- Tablet endpoint ----
# The tablet's IP on your LAN, or its Tailscale hostname (e.g. tablet.tail-xxx.ts.net)
# Port must have been pinned once over USB: `adb tcpip 5555` (see README).
TABLET_HOST=192.168.1.50
TABLET_PORT=5555

# ---- Keepalive ----
# How often (seconds) the relay re-checks the adb connection and reconnects
# after tablet reboots / Wi-Fi flaps.
KEEPALIVE_INTERVAL=30

# ---- Network binding ----
# Host IP the relay's port 8000 is published on (docker-compose "ports:").
# ws-scrcpy has no authentication, so this is the only thing restricting
# access. Set this to the relay host's Tailscale IP (e.g. 100.x.x.x) so it's
# reachable over the tailnet but not your LAN. Leaving it at 127.0.0.1 is
# safe but makes the relay unreachable from your iPhone.
# Not used at all if you're fronting the relay with Traefik and want the
# direct port closed off — see "Traefik (optional)" below.
BIND_HOST=127.0.0.1

# ---- Image ----
# Tag to pull from ghcr.io/the-code-labz/scrcpy-tablet-relay (built by
# .github/workflows/docker-publish.yml on every push to main). Pin a sha/
# semver tag for reproducible deploys instead of floating on :latest.
IMAGE_TAG=latest

# ---- Traefik (optional) ----
# Only needed if you front the relay with Traefik instead of (or alongside)
# the direct BIND_HOST:8000 port above. No-op otherwise — Traefik simply
# won't find anything to route if these labels don't match a real setup.
# Hostname Traefik will route to this service.
SCRCPY_HOSTNAME=scrcpy.example.com
# Docker network your Traefik instance watches (Dokploy's default shown).
TRAEFIK_NETWORK=dokploy-network
# Traefik certresolver name for automatic TLS.
TRAEFIK_CERTRESOLVER=cloudflare

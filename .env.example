# ---- Tablet endpoint ----
# The tablet's IP on your LAN, or its Tailscale hostname (e.g. tablet.tail-xxx.ts.net)
TABLET_HOST=192.168.1.50

# Leave TABLET_PORT blank for Android 11+ Wireless debugging (the normal
# case) — the relay auto-discovers the live connect port itself (see
# ADB_PORT_DISCOVERY below) and caches it, so you never read a port off the
# tablet's screen. Only set this for legacy Android <11 USB-pinned mode
# (`adb tcpip 5555` once over USB), where the port really is fixed at 5555.
TABLET_PORT=

# ---- Wireless debugging port auto-discovery ----
# Android 11+ Wireless Debugging's *connect* port is an OS-assigned
# ephemeral port that changes on every Wi-Fi reconnect, reboot, or
# debugging toggle. The official discovery mechanism (mDNS) doesn't work
# here because mDNS is link-local multicast and Tailscale does not relay
# multicast/broadcast traffic between peers — so instead the relay runs a
# bounded nmap scan + adb-connect probe to find the live port whenever the
# cached one stops working, and caches the result for next boot.
#   auto (default) — scan automatically when the known port fails.
#   off            — never scan; only ever try TABLET_PORT (legacy mode).
ADB_PORT_DISCOVERY=auto
# Port range scanned during discovery. Default covers every Wireless
# Debugging connect port observed in practice; narrow it if you want faster
# scans on a network you've characterized.
DISCOVERY_PORT_RANGE=32768-61000

# ---- One-time Wireless debugging pairing (Android 11+ only) ----
# Get these from the tablet's Settings > Developer options > Wireless
# debugging > "Pair device with pairing code" screen — it shows a DIFFERENT
# ip:port than the main Wireless debugging screen, plus a 6-digit code.
# Fill in, redeploy once, confirm `docker compose logs` shows "Successfully
# paired", then blank these three back out — the trust persists in
# ./adb-data (mounted over ~/.android) so you never need this again unless
# the tablet's adb key store gets wiped (factory reset, "Revoke wireless
# debugging authorizations", etc). Codes expire in ~60 seconds, so have the
# tablet screen open and redeploy immediately after filling these in.
PAIR_HOST=
PAIR_PORT=
PAIR_CODE=

# ---- Keepalive ----
# How often (seconds) the relay re-checks the adb connection and reconnects
# after tablet reboots / Wi-Fi flaps.
KEEPALIVE_INTERVAL=30

# ---- Network binding ----
# Host IP the relay's port 8000 is published on (docker-compose "ports:").
# ws-scrcpy has no authentication, so this is the only thing restricting
# access. Set this to the relay host's Tailscale IP (e.g. 100.x.x.x) so it's
# reachable over the tailnet but not your LAN. Leaving it at 127.0.0.1 is
# safe but makes the relay unreachable from your iPhone.
# Not used at all if you're fronting the relay with Traefik and want the
# direct port closed off — see "Traefik (optional)" below.
BIND_HOST=127.0.0.1

# ---- Image ----
# Tag to pull from ghcr.io/the-code-labz/scrcpy-tablet-relay (built by
# .github/workflows/docker-publish.yml on every push to main). Pin a sha/
# semver tag for reproducible deploys instead of floating on :latest.
IMAGE_TAG=latest

# ---- Audio sidecar (optional) ----
# tango-mirror (stock scrcpy v3.1, WebRTC video + Opus audio + touch) runs
# as a separate `scrcpy-audio` service alongside the video-only relay
# above, because ws-scrcpy's vendored scrcpy-server predates scrcpy's
# audio protocol entirely. It runs with `network_mode: host` (needed for
# WebRTC's UDP media), so TANGO_TOKEN is REQUIRED — without it this
# service would be an unauthenticated screen+audio+touch session reachable
# on every interface the host has, not just the tailnet. Comment the
# `scrcpy-audio` service out of docker-compose.yml entirely if you don't
# want audio.
# Port the audio sidecar listens on (host networking — no BIND_HOST here;
# firewall this to the tailnet at the OS/router level, same spirit as
# BIND_HOST above).
TANGO_PORT=8010
# Required. Generate something random, e.g.: openssl rand -hex 16
TANGO_TOKEN=

# ---- Traefik (optional) ----
# Only needed if you front the relay with Traefik instead of (or alongside)
# the direct BIND_HOST:8000 port above. No-op otherwise — Traefik simply
# won't find anything to route if these labels don't match a real setup.
# Hostname Traefik will route to this service.
SCRCPY_HOSTNAME=scrcpy.example.com
# Docker network your Traefik instance watches (Dokploy's default shown).
TRAEFIK_NETWORK=dokploy-network
# Traefik certresolver name for automatic TLS.
TRAEFIK_CERTRESOLVER=cloudflare

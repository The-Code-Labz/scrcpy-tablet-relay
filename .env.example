# ---- Tablet endpoint ----
# The tablet's IP on your LAN, or its Tailscale hostname (e.g. tablet.tail-xxx.ts.net)
# Port must have been pinned once over USB: `adb tcpip 5555` (see README).
TABLET_HOST=192.168.1.50
TABLET_PORT=5555

# ---- Keepalive ----
# How often (seconds) the relay re-checks the adb connection and reconnects
# after tablet reboots / Wi-Fi flaps.
KEEPALIVE_INTERVAL=30

# ---- ws-scrcpy options (optional) ----
# Extra CLI flags passed to ws-scrcpy, space-separated.
# Examples:
#   WSSCRCPY_OPTS=--port 8000
# Leave empty for defaults.
WSSCRCPY_OPTS=

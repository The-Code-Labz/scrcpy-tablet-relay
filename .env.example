# ---- Tablet endpoint ----
# The tablet's IP on your LAN, or its Tailscale hostname (e.g. tablet.tail-xxx.ts.net)
# Port must have been pinned once over USB: `adb tcpip 5555` (see README).
TABLET_HOST=192.168.1.50
TABLET_PORT=5555

# ---- Keepalive ----
# How often (seconds) the relay re-checks the adb connection and reconnects
# after tablet reboots / Wi-Fi flaps.
KEEPALIVE_INTERVAL=30

# ---- Network binding ----
# Host IP the relay's port 8000 is published on (docker-compose "ports:").
# ws-scrcpy has no authentication, so this is the only thing restricting
# access. Set this to the relay host's Tailscale IP (e.g. 100.x.x.x) so it's
# reachable over the tailnet but not your LAN. Leaving it at 127.0.0.1 is
# safe but makes the relay unreachable from your iPhone.
BIND_HOST=127.0.0.1
